# db
POSTGRES_URL="postgresql://username:password@localhost:5432/blood_donations"
POSTGRES_PRISMA_URL="postgresql://username:password@localhost:5432/blood_donations"
POSTGRES_URL_NON_POOLING="postgresql://username:password@localhost:5432/blood_donations"
POSTGRES_USER="username"
POSTGRES_HOST="localhost:5432"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="blood_donations"

# next auth
NEXTAUTH_SECRET="supersecret"
NEXTAUTH_URL="http://localhost:3000"

# seed: optional path to the donor CSV (defaults to prisma/donors.csv, which git ignores)
# DONORS_CSV="/path/outside/the/repo/donors.csv"

# seed: admin login. Required for any database not on localhost; locally the
# default admin@admin.admin / AdminPassword123 is used when unset.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="choose-a-strong-password"
